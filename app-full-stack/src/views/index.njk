<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Aplicación Segura Completa</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        display: flex;
        flex-direction: column;
        height: 100vh;
      }

      #navbar {
        background: #333;
        color: white;
        padding: 1rem;
        display: flex;
        align-items: center;
      }

      #layout {
        flex: 1;
        display: flex;
        overflow: hidden;
      }

      #sidebar {
        width: 0;
        background: #555;
        color: white;
        transition: width 0.3s ease;
        overflow-x: hidden;
        padding-top: 1rem;
      }

      #sidebar.open {
        width: 200px;
      }

      #sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      #sidebar li {
        padding: 0.5rem 1rem;
      }

      #sidebar li a {
        color: white;
        text-decoration: none;
      }

      #app {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
      }

      #footer {
        background: #333;
        color: white;
        text-align: center;
        padding: 1rem;
      }
    </style>
  </head>
  <body>
    <header id="navbar">
      <button id="toggleSidebar">☰</button>
      <h1 style="margin: 0">Mi App</h1>
    </header>

    <div id="layout">
      <nav id="sidebar">
        <ul id="sidebar-routes"></ul>
      </nav>

      <main id="app">
        <!-- Aquí va el contenido dinámico -->
      </main>
    </div>

    <script
      {%
      if
      not
      isProduction
      %}type="module"
      {%
      endif
      %}
      src="/{{ scriptPath }}"
    ></script>
  </body>
</html>
