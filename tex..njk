


<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Aplicación Segura Completa</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        display: flex;
        flex-direction: column;
        height: 100vh;
      }

      #navbar {
        background: #333;
        color: white;
        padding: 1rem;
        display: flex;
        align-items: center;
      }

      #layout {
        flex: 1;
        display: flex;
        overflow: hidden;
      }

      #sidebar {
        width: 0;
        background: #555;
        color: white;
        transition: width 0.3s ease;
        overflow-x: hidden;
        padding-top: 1rem;
      }

      #sidebar.open {
        width: 200px;
      }

      #sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      #sidebar li {
        padding: 0.5rem 1rem;
      }

      #sidebar li a {
        color: white;
        text-decoration: none;
      }

      #app {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
      }

      #footer {
        background: #333;
        color: white;
        text-align: center;
        padding: 1rem;
      }
    </style>
  </head>
  <body>
    <header id="navbar">
      <button id="toggleSidebar">☰</button>
      <h1 style="margin: 0">Mi App</h1>
    </header>

    <div id="layout">
      <nav id="sidebar">
        <ul id="sidebar-routes"></ul>
      </nav>

      <div id="main">
        {% block content %}
        <!-- Aquí irá el contenido dinámico -->
        {% endblock %}
      </div>
    </div>
    {% include "partials/footer.njk" %}

    <script>
      // Función para manejar la apertura y cierre del sidebar
      const toggleSidebarButton = document.getElementById('toggleSidebar');
      const sidebar = document.getElementById('sidebar');
      toggleSidebarButton.addEventListener('click', () => {
        sidebar.classList.toggle('open');
      });

      // Fetch para obtener las rutas y cargarlas en el sidebar
      fetch('/api/routes')
        .then((response) => response.json())
        .then((routes) => {
          const sidebarRoutes = document.getElementById('sidebar-routes');

          // Limpiar el contenido del sidebar en caso de que ya esté cargado
          sidebarRoutes.innerHTML = '';

          routes.forEach((route) => {
            const menuItem = document.createElement('li');
            const link = document.createElement('a');
            link.href = route.path;
            link.textContent = route.title;
            menuItem.appendChild(link);

            // Agregar subrutas si existen
            if (route.subroutes && route.subroutes.length > 0) {
              const subMenu = document.createElement('ul');
              route.subroutes.forEach((subroute) => {
                const subMenuItem = document.createElement('li');
                const subLink = document.createElement('a');
                subLink.href = subroute.path;
                subLink.textContent = subroute.title;
                subMenuItem.appendChild(subLink);
                subMenu.appendChild(subMenuItem);
              });
              menuItem.appendChild(subMenu);
            }

            // Añadir item de menú a la lista del sidebar
            sidebarRoutes.appendChild(menuItem);
          });
        })
        .catch((error) => console.error('Error fetching routes:', error));
    </script>

    <script>
      function loadPage(path) {
        fetch(`/api/page?path=${path}`)
          .then((res) => res.json())
          .then((data) => {
            const content = document.getElementById('main');
            if (content) content.innerHTML = data.html;
            history.pushState(null, '', path);
          })
          .catch((err) => {
            console.error('Error al cargar contenido:', err);
          });
      }

      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.getAttribute('href').startsWith('/')) {
          e.preventDefault();
          loadPage(link.getAttribute('href'));
        }
      });

      window.addEventListener('popstate', () => {
        loadPage(location.pathname);
      });

      window.addEventListener('DOMContentLoaded', () => {
        loadPage(location.pathname);
      });
    </script>

    <script src="{{ scriptPath }}"></script>
  </body>
</html>

